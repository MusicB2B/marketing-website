# ---------------------------------------------------------------------------
# Fanbased marketing website — environment
#
# Copy to .env.local for local dev:  cp .env.example .env.local
# In production these are set in Vercel → Project → Settings → Environment
# Variables. Never commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# --- Content authoring -----------------------------------------------------
# Shared credential for the authoring route.
EDITOR_PASSWORD=

# Signs the authoring session cookie so it cannot be forged.
# Generate a fresh one with:  openssl rand -hex 32
EDITOR_SESSION_SECRET=

# How long a session lasts, in hours. Optional, defaults to 12.
EDITOR_SESSION_HOURS=12


# --- Content storage (GitHub) ----------------------------------------------
# Content changes are committed back to this repository, which triggers a
# redeploy and gives a full history of every change.
#
# Leave GITHUB_TOKEN empty in local dev and writes go to the local file
# instead, which is handy for working offline without touching the repo.

# Fine-grained personal access token, scoped to ONLY this repo,
# with Repository permissions → Contents: Read and write.
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

GITHUB_OWNER=MusicB2B
GITHUB_REPO=marketing-website
GITHUB_BRANCH=main

# Path to the content document inside the repo. Rarely needs changing.
CONTENT_PATH=content/site.json


# --- Request access form ---------------------------------------------------
# The enquiry form emails the team. Sent via Resend's REST API
# (https://resend.com) — free tier covers 3,000 emails a month, no card needed.
#
# Leave RESEND_API_KEY empty and the form returns a friendly "not connected
# yet" message rather than failing silently.

# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land.
CONTACT_EMAIL=contact@fanbasedhq.com

# The From address. Until you verify a domain with Resend, leave this unset and
# it falls back to onboarding@resend.dev, which works immediately for testing.
CONTACT_FROM_EMAIL=


# --- Site ------------------------------------------------------------------
# Canonical URL, used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://fanbasedhq.com
