# ---------------------------------------------------------------------------
# fanbasd marketing website — environment
#
# Copy to .env.local for local dev:  cp .env.example .env.local
# In production these are set in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# --- Editor access ---------------------------------------------------------
# The shared password for /edit. Give this to product/marketing/sales.
# Change it by updating this value in Vercel and redeploying — no code change.
EDITOR_PASSWORD=change-me-before-you-share-this

# Signs the editor session cookie so it can't be forged.
# Generate a fresh one with:  openssl rand -hex 32
EDITOR_SESSION_SECRET=

# How long an editor stays signed in, in hours. Optional, defaults to 12.
EDITOR_SESSION_HOURS=12


# --- Content storage (GitHub) ----------------------------------------------
# Saving in /edit commits content/site.json back to this repo, which triggers
# a Vercel redeploy. That gives you a full history of every copy change.
#
# Leave GITHUB_TOKEN empty in local dev and saves write to the local file
# instead — handy for working offline without touching the repo.

# Fine-grained personal access token, scoped to ONLY this repo,
# with Repository permissions → Contents: Read and write.
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

GITHUB_OWNER=MusicB2B
GITHUB_REPO=marketing-website
GITHUB_BRANCH=main

# Path to the content document inside the repo. Rarely needs changing.
CONTENT_PATH=content/site.json


# --- Site ------------------------------------------------------------------
# Canonical URL, used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://fanbasd.com
